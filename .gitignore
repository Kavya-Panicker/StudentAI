# ==========================================
# StudentAI — Root .gitignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/

# Environment Variables & Secrets (NEVER push to Git)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env.*.local

# Allow example env files
!.env.example
!**/.env.example

# Python Virtual Environments & Packages
.venv/
.venv*/
venv/
env/
ENV/
backend/.venv-face/
**/__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# Production Build Artifacts
dist/
dist-ssr/
frontend/dist/
build/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / IDE Files
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temporary & Cache Files
*.tmp
.cache/
.pytest_cache/

